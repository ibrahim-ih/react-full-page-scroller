{
  "name": "react-full-page-scroller",
  "version": "0.2.0",
  "description": "A react module for full page scroll",
  "author": "Ibrahim Haouari",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/ibrahim-ih"
  },
  "repository": "git://github.com/ibrahim-ih/react-full-page-scroller.git",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "types": "dist/types/index.d.ts",
  "source": "src/index.tsx",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.21.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "vite build",
    "build:types": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "vite build --watch",
    "prepare": "npm run build",
    "test": "npm run test:unit && npm run test:lint && npm run test:format && npm run typecheck && npm run test:build",
    "test:build": "npm run build",
    "test:lint": "eslint .",
    "test:format": "prettier --check .",
    "test:unit": "jest --selectProjects library --watchAll=false",
    "e2e:build": "npm run build && npm run build --prefix example",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "jest --selectProjects library --watch",
    "jest": "jest --selectProjects library",
    "coverage": "jest --selectProjects library --coverage --watchAll=false",
    "predeploy": "npm ci --prefix example && npm run build --prefix example",
    "deploy": "gh-pages -d example/build"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "overrides": {
    "babel-preset-current-node-syntax": "npm:babel-preset-current-node-syntax-compat@^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.49",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12 || ^19.0.0",
    "@types/react-dom": "^18.3.1 || ^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "ts-declaration-location": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "files": [
    "dist/index.js",
    "dist/index.modern.js",
    "dist/types"
  ],
  "keywords": [
    "react",
    "reactjs",
    "ssr",
    "javascript",
    "typescript"
  ]
}
